# ====================================================================
# TVV Travel OS — Environment Variable Reference
# Copy this to .env.local / .env.staging / .env.production
# NEVER commit real values — use secrets manager in production.
# ====================================================================

# -- Database ----------------------------------------------------------
DATABASE_URL="postgresql://USER:PASS@HOST:PORT/DBNAME?sslmode=require"

# -- Auth --------------------------------------------------------------
AUTH_JWT_SECRET="<64-char-random-hex>"
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600

# -- Redis (BullMQ + Caching) ------------------------------------------
# Upstash: rediss://default:PASSWORD@HOST:PORT
# Self-hosted: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# -- Frontend / CORS ---------------------------------------------------
FRONTEND_URL="https://thevacationvoice.in"
NEXT_PUBLIC_WEBSITE_BASE_URL="https://thevacationvoice.in"
CORS_ALLOWED_ORIGINS="https://thevacationvoice.in"

# -- OpenAI ------------------------------------------------------------
# Stored encrypted in DB via Integrations vault — set here only for local dev.
OPENAI_API_KEY="sk-proj-..."

# -- TripJack ----------------------------------------------------------
TRIPJACK_ENABLED=true
TRIPJACK_API_URL="https://api.tripjack.com/"        # PRODUCTION URL (no "test")
TRIPJACK_USER_ID="YOUR_USER_ID"
TRIPJACK_AGENCY_ID="YOUR_AGENCY_ID"
TRIPJACK_TOKEN="YOUR_LIVE_TOKEN"
TRIPJACK_EMAIL="YOUR_EMAIL"
TRIPJACK_PASSWORD="YOUR_PASSWORD"

# -- Digital Ocean Spaces (Media Storage) -----------------------------
DO_SPACES_ENDPOINT="https://sfo3.digitaloceanspaces.com"
DO_SPACES_REGION="sfo3"
DO_SPACES_BUCKET="thevacationvoice"
DO_SPACES_KEY="YOUR_SPACES_KEY"
DO_SPACES_SECRET="YOUR_SPACES_SECRET"
DO_SPACES_CDN="https://thevacationvoice.sfo3.cdn.digitaloceanspaces.com"

# -- Payments ----------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_..."                       # LIVE key for production
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# -- SMTP (Transactional Email) ----------------------------------------
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="booking@thevacationvoice.in"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM='"TVV Travel OS" <booking@thevacationvoice.in>'

# -- Integrations Encryption Key ---------------------------------------
INTEGRATION_SECRETS_KEY="<48-char-hex-key>"

# -- TVV Internal API Key (Frontend ? Backend server auth) -------------
TVV_API_KEY="tvv_<your-secret-key>"
